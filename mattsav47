-- =============================================
-- KEYBIND HANDLER
-- =============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- God Mode keybind
    local godKey = Cfg.GodMode.ToggleKey
    if godKey then
        if typeof(godKey) == "EnumItem" then
            if input.KeyCode == godKey or input.UserInputType == godKey then
                ToggleGodMode()
                -- Update button if exists
                pcall(function()
                    if GodModeButton then
                        GodModeButton.BackgroundColor3 = Cfg.GodMode.Enabled and RED or GREEN
                        GodModeButton.Text = Cfg.GodMode.Enabled and "🛡️ DISABLE GOD MODE" or "🛡️ ENABLE GOD MODE"
                    end
                end)
            end
        elseif typeof(godKey) == "string" then
            pcall(function()
                local kc = Enum.KeyCode[godKey]
                if kc and input.KeyCode == kc then
                    ToggleGodMode()
                    pcall(function()
                        if GodModeButton then
                            GodModeButton.BackgroundColor3 = Cfg.GodMode.Enabled and RED or GREEN
                            GodModeButton.Text = Cfg.GodMode.Enabled and "🛡️ DISABLE GOD MODE" or "🛡️ ENABLE GOD MODE"
                        end
                    end)
                end
            end)
        end
    end
    
    -- Fly keybind
    local flyKey = Cfg.Movement.FlyKeybind
    if flyKey then
        if typeof(flyKey) == "EnumItem" then
            if input.KeyCode == flyKey or input.UserInputType == flyKey then
                ToggleFly()
            end
        elseif typeof(flyKey) == "string" then
            pcall(function()
                local kc = Enum.KeyCode[flyKey]
                if kc and input.KeyCode == kc then
                    ToggleFly()
                end
            end)
        end
    end
    
    -- Teleport keybind
    local tpKey = Cfg.Misc.TPKeybind
    if Cfg.Misc.ClickTP and tpKey then
        if typeof(tpKey) == "EnumItem" then
            if input.KeyCode == tpKey or input.UserInputType == tpKey then
                HandleClickTP()
            end
        elseif typeof(tpKey) == "string" then
            pcall(function()
                local kc = Enum.KeyCode[tpKey]
                if kc and input.KeyCode == kc then
                    HandleClickTP()
                end
            end)
        end
    end
end)

