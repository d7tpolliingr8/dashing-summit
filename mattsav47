local function ApplyGodMode()
    if not Cfg.GodMode.Enabled then return end
    
    local humanoid = GetHumanoid()
    if not humanoid then return end
    
    -- Keep health full
    if Cfg.GodMode.KeepHealthFull then
        humanoid.Health = humanoid.MaxHealth
    end
    
    -- No fall damage
    if Cfg.GodMode.NoFallDamage then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 50
    end
    
    -- No drowning
    if Cfg.GodMode.NoDrown then
        humanoid.Breath = 100
    end
    
    -- Instant heal when damaged
    if Cfg.GodMode.InstantHeal then
        if humanoid.Health < humanoid.MaxHealth then
            task.wait(Cfg.GodMode.HealDelay)
            humanoid.Health = humanoid.MaxHealth
        end
    end
end

