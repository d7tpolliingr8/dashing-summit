local function FindItems()
    local items = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and IsItem(obj) then
            table.insert(items, obj)
        end
    end
    return items
end

local function DoAutoCollect()
    if not Cfg.Misc.AutoCollect then return end
    
    local root = GetRoot()
    if not root then return end
    
    local items = FindItems()
    for _, item in ipairs(items) do
        if item then
            local dist = (item.Position - root.Position).Magnitude
            if dist <= Cfg.Misc.CollectRadius then
                root.CFrame = CFrame.new(item.Position + Vector3.new(0, 2, 0))
                task.wait(Cfg.Misc.CollectDelay)
            end
        end
    end
end

