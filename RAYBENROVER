local function FindCoins()
    local coins = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name and string.find(string.lower(obj.Name), "coin") then
            table.insert(coins, obj)
        end
    end
    return coins
end

local function FindKnives()
    local knives = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name and string.find(string.lower(obj.Name), "knife") then
            table.insert(knives, obj)
        end
    end
    return knives
end

local function DoAutoCollect()
    if not Cfg.Misc.AutoCollect then return end
    
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local coins = FindCoins()
    for _, coin in ipairs(coins) do
        if coin then
            local dist = (coin.Position - myRoot.Position).Magnitude
            if dist <= Cfg.Misc.AutoCollectRadius then
                -- Move to coin
                myRoot.CFrame = CFrame.new(coin.Position)
                task.wait(Cfg.Misc.AutoCollectDelay)
            end
        end
    end
end

