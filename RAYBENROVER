local ESPs = {}
local OffscreenArrows = {}
local CoinESP = {}
local KnifeESP = {}

local function CreateOffscreenArrows(player)
    if OffscreenArrows[player] then return end
    local arrowGroup = {}
    for i = 1, 3 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 2
        line.Color = RED
        line.ZIndex = 8
        arrowGroup[i] = line
    end
    OffscreenArrows[player] = arrowGroup
end

local function DestroyOffscreenArrows(player)
    local arrowGroup = OffscreenArrows[player]
    if arrowGroup then
        for _, line in ipairs(arrowGroup) do
            pcall(function() line:Remove() end)
        end
        OffscreenArrows[player] = nil
    end
end

local function CreateESPObjects(player)
    if ESPs[player] then return end
    local o = {}
    
    o.HB = {
        L{ Color = Color3.fromRGB(15,15,15), Thickness = 2, ZIndex = 5 },
        L{ Color = GREEN, Thickness = 2, ZIndex = 6 },
    }
    
    o.Name = T{ Color = WHITE, Size = 14, ZIndex = 6 }
    o.Dist = T{ Color = Color3.fromRGB(200,200,200), Size = 11, ZIndex = 6 }
    o.Role = T{ Color = WHITE, Size = 12, ZIndex = 6 }
    
    o.Tr = L{ Color = RED, ZIndex = 3, Thickness = 1.5 }
    o.TrO = L{ Color = BLACK, Thickness = 3, ZIndex = 2 }
    
    o.Box = {}
    for i = 1, 4 do
        o.Box[i] = L{ Color = YELLOW, Thickness = 1.5, ZIndex = 5 }
    end
    o.BoxO = {}
    for i = 1, 4 do
        o.BoxO[i] = L{ Color = BLACK, Thickness = 3, ZIndex = 4 }
    end
    
    o.Corner = {}
    for i = 1, 8 do
        o.Corner[i] = L{ Color = RED, Thickness = 2, ZIndex = 5 }
    end
    
    o.Chams = nil
    o.HeadDot = C{ Color = RED, Thickness = 1, ZIndex = 7, Radius = 5, Filled = true }
    o.GunESP = L{ Color = YELLOW, Thickness = 2, ZIndex = 5 }
    
    ESPs[player] = o
    CreateOffscreenArrows(player)
end

local function DestroyESP(player)
    local o = ESPs[player]
    if not o then return end
    for _, l in ipairs(o.HB) do pcall(function() l:Remove() end) end
    for _, l in ipairs(o.Box or {}) do pcall(function() l:Remove() end) end
    for _, l in ipairs(o.BoxO or {}) do pcall(function() l:Remove() end) end
    for _, l in ipairs(o.Corner or {}) do pcall(function() l:Remove() end) end
    pcall(function() o.Name:Remove() end)
    pcall(function() o.Dist:Remove() end)
    pcall(function() o.Role:Remove() end)
    pcall(function() o.Tr:Remove() end)
    pcall(function() o.TrO:Remove() end)
    if o.Chams then pcall(function() o.Chams:Destroy() end) end
    pcall(function() o.HeadDot:Remove() end)
    pcall(function() o.GunESP:Remove() end)
    ESPs[player] = nil
    DestroyOffscreenArrows(player)
end

local function HideESP(o)
    for _, l in ipairs(o.HB) do l.Visible = false end
    for _, l in ipairs(o.Box or {}) do l.Visible = false end
    for _, l in ipairs(o.BoxO or {}) do l.Visible = false end
    for _, l in ipairs(o.Corner or {}) do l.Visible = false end
    o.Name.Visible = false
    o.Dist.Visible = false
    o.Role.Visible = false
    o.Tr.Visible = false
    if o.TrO then o.TrO.Visible = false end
    if o.Chams then o.Chams.Enabled = false end
    if o.HeadDot then o.HeadDot.Visible = false end
    o.GunESP.Visible = false
end

local function UpdateOffscreenArrows()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        local arrowGroup = OffscreenArrows[player]
        if not arrowGroup then continue end
        
        local char = player.Character
        if not char then 
            for _, l in ipairs(arrowGroup) do l.Visible = false end
            continue 
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then 
            for _, l in ipairs(arrowGroup) do l.Visible = false end
            continue 
        end
        
        if not Cfg.ESP.On or not Cfg.ESP.OffscreenArrows then
            for _, l in ipairs(arrowGroup) do l.Visible = false end
            continue
        end
        
        -- Check if we should show arrow based on role
        local role = GetPlayerRole(player)
        if role == "Innocent" and not Cfg.ESP.ShowInnocent then
            for _, l in ipairs(arrowGroup) do l.Visible = false end
            continue
        end
        
        local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            for _, l in ipairs(arrowGroup) do l.Visible = false end
            continue
        end
        
        local vp = Camera.ViewportSize
        local center = Vector2.new(vp.X / 2, vp.Y / 2)
        local camCFrame = Camera.CFrame
        local playerPos = hrp.Position
        
        local relPos = camCFrame:PointToObjectSpace(playerPos)
        local angle = math.atan2(relPos.X, relPos.Z)
        local radius = math.clamp(vp.X * 0.35, 100, 350)
        
        local arrowPos = Vector2.new(
            center.X + math.sin(angle) * radius,
            center.Y - math.cos(angle) * (radius * 0.75)
        )
        
        local size = 14
        local rot = angle
        
        local p1 = arrowPos + Vector2.new(math.sin(rot), -math.cos(rot)) * size
        local p2 = arrowPos + Vector2.new(math.sin(rot + math.rad(140)), -math.cos(rot + math.rad(140))) * (size * 0.7)
        local p3 = arrowPos + Vector2.new(math.sin(rot - math.rad(140)), -math.cos(rot - math.rad(140))) * (size * 0.7)
        
        arrowGroup[1].From = p1
        arrowGroup[1].To = p2
        arrowGroup[2].From = p2
        arrowGroup[2].To = p3
        arrowGroup[3].From = p3
        arrowGroup[3].To = p1
        
        local col = Cfg.ESP.OffscreenArrowColor or RED
        for _, l in ipairs(arrowGroup) do
            l.Color = col
            l.Visible = true
        end
    end
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        CreateESPObjects(player)
        local o = ESPs[player]
        local char = player.Character
        if not char then HideESP(o); continue end
        
        local hrp, hum = Parts(char)
        if not hrp or not hum then HideESP(o); continue end
        
        local role = GetPlayerRole(player)
        
        -- Filter by role settings
        if role == "Murderer" and not Cfg.ESP.ShowMurderer then HideESP(o); continue end
        if role == "Sheriff" and not Cfg.ESP.ShowSheriff then HideESP(o); continue end
        if role == "Innocent" and not Cfg.ESP.ShowInnocent then HideESP(o); continue end
        
        local myChar = LP.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local dist = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
        if dist > Cfg.ESP.MaxDist then HideESP(o); continue end
        
        local bb = BBox(char)
        if not bb then HideESP(o); continue end
        if not Cfg.ESP.On then HideESP(o); continue end
        
        local x, y, w, h = bb.X, bb.Y, bb.W, bb.H
        
        -- Get role color
        local roleColor = WHITE
        if role == "Murderer" then roleColor = Cfg.ESP.MurdererColor
        elseif role == "Sheriff" then roleColor = Cfg.ESP.SheriffColor
        else roleColor = Cfg.ESP.InnocentColor end
        
        -- Name
        if Cfg.ESP.Names then
            o.Name.Position = Vector2.new(bb.CX, bb.Y - 30)
            o.Name.Text = player.DisplayName or player.Name
            o.Name.Color = Cfg.ESP.NameColor
            o.Name.Visible = true
        else
            o.Name.Visible = false
        end
        
        -- Role label
        o.Role.Position = Vector2.new(bb.CX, bb.Y - 16)
        o.Role.Text = role
        o.Role.Color = roleColor
        o.Role.Visible = true
        
        -- Distance
        if Cfg.ESP.Dist then
            o.Dist.Position = Vector2.new(bb.CX, bb.Y + bb.H + 3)
            o.Dist.Text = string.format("[%dm]", math.floor(dist))
            o.Dist.Color = Cfg.ESP.DistColor
            o.Dist.Visible = true
        else
            o.Dist.Visible = false
        end
        
        -- Box
        if Cfg.ESP.Box then
            local function SetLine(out, bg, f, t, color)
                bg.From = f
                bg.To = t
                bg.Visible = true
                out.From = f
                out.To = t
                out.Color = color
                out.Visible = true
            end
            local col = Cfg.ESP.BoxColor
            SetLine(o.Box[1], o.BoxO[1], Vector2.new(x, y), Vector2.new(x + w, y), col)
            SetLine(o.Box[2], o.BoxO[2], Vector2.new(x, y + h), Vector2.new(x + w, y + h), col)
            SetLine(o.Box[3], o.BoxO[3], Vector2.new(x, y), Vector2.new(x, y + h), col)
            SetLine(o.Box[4], o.BoxO[4], Vector2.new(x + w, y), Vector2.new(x + w, y + h), col)
        else
            for i = 1, 4 do
                o.Box[i].Visible = false
                o.BoxO[i].Visible = false
            end
        end
        
        -- Corner Box
        if Cfg.ESP.CornerBox then
            local len = math.min(w, h) * 0.2
            local col = Cfg.ESP.CornerColor
            local corners = {
                {Vector2.new(x, y + len), Vector2.new(x, y), Vector2.new(x + len, y)},
                {Vector2.new(x + w - len, y), Vector2.new(x + w, y), Vector2.new(x + w, y + len)},
                {Vector2.new(x, y + h - len), Vector2.new(x, y + h), Vector2.new(x + len, y + h)},
                {Vector2.new(x + w - len, y + h), Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - len)},
            }
            for i, corner in ipairs(corners) do
                local idx = (i - 1) * 2 + 1
                o.Corner[idx].From = corner[1]
                o.Corner[idx].To = corner[2]
                o.Corner[idx].Color = col
                o.Corner[idx].Visible = true
                o.Corner[idx + 1].From = corner[2]
                o.Corner[idx + 1].To = corner[3]
                o.Corner[idx + 1].Color = col
                o.Corner[idx + 1].Visible = true
            end
        else
            for i = 1, 8 do
                o.Corner[i].Visible = false
            end
        end
        
        -- Tracers
        if Cfg.ESP.Tracers then
            local vp = Camera.ViewportSize
            local from = Vector2.new(vp.X / 2, vp.Y)
            o.Tr.From = from
            o.Tr.To = bb.BS
            o.Tr.Color = Cfg.ESP.TraceColor
            o.Tr.Visible = true
            o.TrO.From = from
            o.TrO.To = bb.BS
            o.TrO.Visible = true
        else
            o.Tr.Visible = false
            o.TrO.Visible = false
        end
        
        -- Chams
        if Cfg.ESP.Chams then
            if not o.Chams or o.Chams.Parent ~= char then
                if o.Chams then o.Chams:Destroy() end
                local h = Instance.new("Highlight")
                h.Adornee = char
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = char
                o.Chams = h
            end
            o.Chams.Enabled = true
            o.Chams.FillColor = Cfg.ESP.ChamsColor
            o.Chams.FillTransparency = Cfg.ESP.ChamsTrans
            o.Chams.OutlineColor = RED
            o.Chams.OutlineTransparency = 0.5
        elseif o.Chams then
            o.Chams.Enabled = false
        end
        
        -- Head Dot
        if Cfg.ESP.HeadDot then
            local head = char:FindFirstChild("Head")
            if head then
                local sp, on = W2S(head.Position)
                if on then
                    o.HeadDot.Position = sp
                    o.HeadDot.Color = Cfg.ESP.HeadDotColor
                    o.HeadDot.Visible = true
                else
                    o.HeadDot.Visible = false
                end
            end
        else
            o.HeadDot.Visible = false
        end
        
        -- Gun ESP
        if Cfg.ESP.ShowGun then
            local gun = GetPlayerGun(player)
            if gun then
                local sp, on = W2S(gun.Position)
                if on then
                    -- Draw line from gun to bottom of screen
                    local vp = Camera.ViewportSize
                    o.GunESP.From = sp
                    o.GunESP.To = Vector2.new(sp.X, vp.Y)
                    o.GunESP.Color = Cfg.ESP.GunColor
                    o.GunESP.Visible = true
                else
                    o.GunESP.Visible = false
                end
            else
                o.GunESP.Visible = false
            end
        end
    end
end

-- ================================================
--  AIMBOT SYSTEM - MM2 Optimized
-- ================================================
local FOVCIRC = C{ Color = RED, ZIndex = 10 }
local CurrentTarget = nil

local function GetAimPart(char)
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function GetTargetPosition(char, part, predict)
    if not part then return nil end
    return part.Position
end

local function IsVisible(targetPos)
    if not Cfg.Aim.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPos - origin).Unit
    local distance = (targetPos - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LP.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local rayResult = workspace:Raycast(origin, direction * distance, raycastParams)
    return not rayResult
end

local function IsValidTarget(player)
    if not player or player == LP then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    
    local role = GetPlayerRole(player)
    
    -- Filter by aim settings
    if role == "Murderer" and not Cfg.Aim.AimMurderer then return false end
    if role == "Sheriff" and not Cfg.Aim.AimSheriff then return false end
    if role == "Innocent" then return false end -- Don't aim at innocents
    
    local part = GetAimPart(char)
    if not part then return false end
    
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then
        local dist = (part.Position - myRoot.Position).Magnitude
        if dist > Cfg.Aim.MaxDistance then return false end
    end
    
    return true, char, part, role
end

local function GetClosestTarget()
    local center = AimPoint()
    local best, bestDist = nil, Cfg.Aim.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        local valid, char, part, role = IsValidTarget(player)
        if not valid then continue end
        local pos = GetTargetPosition(char, part, false)
        if not pos then continue end
        if not IsVisible(pos) then continue end
        local screen, onScreen = W2S(pos)
        if not onScreen then continue end
        local dist = (screen - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            best = { Player = player, Char = char, Part = part, Screen = screen, Pos = pos, Role = role }
        end
    end
    return best
end

local function UpdateFOV()
    if Cfg.Aim.ShowFOV and Cfg.Aim.On then
        FOVCIRC.Visible = true
        FOVCIRC.Position = AimPoint()
        FOVCIRC.Radius = Cfg.Aim.FOV
        FOVCIRC.Color = Cfg.Aim.FOVColor
    else
        FOVCIRC.Visible = false
    end
end

local function IsAimKeyPressed()
    local key = Cfg.Aim.AimKey
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.UserInputType then
            return UserInputService:IsMouseButtonPressed(key)
        elseif key.EnumType == Enum.KeyCode then
            return UserInputService:IsKeyDown(key)
        end
    elseif typeof(key) == "string" then
        if key == "MouseButton2" then
            return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        elseif key == "MouseButton1" then
            return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        else
            local success, keyCode = pcall(function() return Enum.KeyCode[key] end)
            if success and keyCode then
                return UserInputService:IsKeyDown(keyCode)
            end
        end
    end
    return false
end

local function DoAim()
    if not Cfg.Aim.On then
        CurrentTarget = nil
        return
    end
    
    local holding = IsAimKeyPressed()
    if not holding then
        CurrentTarget = nil
        return
    end
    
    local target = GetClosestTarget()
    if not target then
        CurrentTarget = nil
        return
    end
    
    CurrentTarget = target
    local aimPos = GetTargetPosition(target.Char, target.Part, true)
    if not aimPos then return end
    
    if Cfg.Aim.Silent then
        local center = AimPoint()
        local screen, on = W2S(aimPos)
        if on then
            local dist = (screen - center).Magnitude
            if dist <= Cfg.Aim.FOV then
                local currentCF = Camera.CFrame
                local targetCF = CFrame.lookAt(currentCF.Position, aimPos)
                if Cfg.Aim.Smoothness <= 0 then
                    Camera.CFrame = targetCF
                else
                    local smooth = math.clamp(1 - Cfg.Aim.Smoothness, 0.01, 1)
                    Camera.CFrame = currentCF:Lerp(targetCF, smooth)
                end
            end
        end
    else
        local currentCF = Camera.CFrame
        local targetCF = CFrame.lookAt(currentCF.Position, aimPos)
        if Cfg.Aim.Smoothness <= 0 then
            Camera.CFrame = targetCF
        else
            local smooth = math.clamp(1 - Cfg.Aim.Smoothness, 0.01, 1)
            Camera.CFrame = currentCF:Lerp(targetCF, smooth)
        end
    end
    
    -- Auto shoot
    if Cfg.Aim.AutoShoot and target then
        pcall(function()
            VirtualUser:ClickButton(Vector2.new())
        end)
    end
end

